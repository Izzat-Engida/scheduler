{
  "expo": {
    "name": "izzat_time",
    "slug": "izzat_time",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Izor.png",
    "scheme": "izzattime",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Izor.png",
        "backgroundImage": "./assets/images/Izor.png",
        "monochromeImage": "./assets/images/Izor.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.izorium.izzat_time"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Izor.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Izor.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08ed128c-260e-4dee-8cb1-421b2965be83"
      }
    }
  }
}
